// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  // Int, not cuid() like the other models: services are a small, public
  // list (shown with prices on the ceník page anyway), so there's no
  // exposure risk in a guessable ID, and short IDs keep ?services=1,2
  // URLs readable for group bookings.
  id                Int       @id @default(autoincrement())
  name              String
  durationMinutes   Int
  price             Int
  active            Boolean   @default(true)
  description       String?
  bookings          Booking[]
}

model Client {
  id                String    @id @default(cuid())
  name              String
  phone             String
  // Nullable in the DB because PHONE/IN_PERSON bookings entered by the
  // pedikérka may not collect it. The online booking form enforces it
  // as required on the client, since that flow depends on email for
  // confirmation, magic links, and reminders.
  email             String?
  extraTimeMinutes  Int       @default(0)
  note              String?
  createdAt         DateTime  @default(now())
  bookings          Booking[]
}

model RecurringAvailability {
  id          String    @id @default(cuid())
  dayOfWeek   Int
  startTime   Int
  endTime     Int
}

enum AvailabilityExceptionType {
  BLOCKED
  EXTRA_OPEN
}

model AvailabilityException {
  id          String                        @id @default(cuid())
  date        DateTime
  type        AvailabilityExceptionType
  startTime   Int?
  endTime     Int?
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  PHONE
  ONLINE
  IN_PERSON
}

model Booking {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  serviceId       Int
  service         Service         @relation(fields: [serviceId], references: [id])
  date            DateTime
  startTime       Int
  endTime         Int
  status          BookingStatus   @default(CONFIRMED)
  groupId         String?
  source          BookingSource
  cancelToken     String          @unique
  reminderSent    Boolean         @default(false)
  createdAt       DateTime        @default(now())
  @@unique([date, startTime])
}

model AdminUser {
  id              String    @id @default(cuid())
  username        String    @unique
  email           String    @unique
  passwordHash    String
}