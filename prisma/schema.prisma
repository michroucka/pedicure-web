// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  // Int, not cuid() like the other models: services are a small, public
  // list (shown with prices on the ceník page anyway), so there's no
  // exposure risk in a guessable ID, and short IDs keep ?services=1,2
  // URLs readable for group bookings.
  id                Int       @id @default(autoincrement())
  name              String
  durationMinutes   Int
  price             Int
  active            Boolean   @default(true)
  description       String?
  bookings          Booking[]
}

model Client {
  id                String    @id @default(cuid())
  name              String
  // Nullable in the DB because PHONE/IN_PERSON bookings entered by the
  // pedikérka may not collect it (e.g. a quick in-person rebooking with
  // a client she already knows). The online booking form still enforces
  // it as required on the client, since the morning reminder SMS and
  // (for email) confirmation/magic-link flow depend on it.
  phone             String?
  // normalizePhoneForMatch(phone) as a Postgres GENERATED ... STORED column
  // (see migration 20261023200000_client_phone_normalized), so findClient
  // matches by an indexed column. Read-only: the DB computes it, never
  // write it. Prisma has no syntax for generated columns – dbgenerated()
  // holds the expression exactly as Postgres reports it, otherwise
  // `migrate dev` would try to drop it as a stray default.
  phoneNormalized   String?   @default(dbgenerated("\nCASE\n    WHEN ((regexp_replace(phone, '\\D'::text, ''::text, 'g'::text) ~~ '420%'::text) AND (length(regexp_replace(phone, '\\D'::text, ''::text, 'g'::text)) > 9)) THEN SUBSTRING(regexp_replace(phone, '\\D'::text, ''::text, 'g'::text) FROM 4)\n    ELSE regexp_replace(phone, '\\D'::text, ''::text, 'g'::text)\nEND"))
  email             String?
  extraTimeMinutes  Int       @default(0)
  note              String?
  // false = "smazaný" v adminu, ale s rezervacemi, které se kvůli historii
  // mazat nesmí – skrytý ze seznamu Klienti a z našeptávače. Při nové
  // rezervaci se klient spáruje i tak a znovu se aktivuje.
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  bookings          Booking[]

  @@index([phoneNormalized])
}

model RecurringAvailability {
  id          String    @id @default(cuid())
  dayOfWeek   Int
  startTime   Int
  endTime     Int
}

enum AvailabilityExceptionType {
  BLOCKED
  EXTRA_OPEN
}

model AvailabilityException {
  id          String                        @id @default(cuid())
  date        DateTime
  type        AvailabilityExceptionType
  startTime   Int?
  endTime     Int?

  @@index([date])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  PHONE
  ONLINE
  IN_PERSON
}

model Booking {
  id                  String          @id @default(cuid())
  clientId            String
  client              Client          @relation(fields: [clientId], references: [id])
  guestName           String?
  serviceId           Int
  service             Service         @relation(fields: [serviceId], references: [id])
  date                DateTime
  startTime           Int
  endTime             Int
  extraTimeMinutes    Int             @default(0)
  status              BookingStatus   @default(CONFIRMED)
  groupId             String?
  source              BookingSource
  cancelToken         String          @unique
  reminderSent        Boolean         @default(false)
  createdAt           DateTime        @default(now())

  // Not expressible in Prisma, added by hand in migrations:
  // - partial unique (date, startTime) among CONFIRMED
  // - exclusion constraint Booking_no_overlap: no two CONFIRMED bookings
  //   on the same date with overlapping [startTime, endTime)
  @@index([clientId])
  @@index([groupId])
}

model AdminUser {
  id                  String              @id @default(cuid())
  username            String              @unique
  email               String              @unique
  passwordHash        String
  pushSubscriptions   PushSubscription[]
}

model PushSubscription {
  id            String      @id @default(cuid())
  adminUserId   String
  adminUser     AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  endpoint      String      @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime    @default(now())
}