# Kopie do .env (dev), .env.local se nepoužívá (Vercel CLI si ho generuje samo)
# a .env.test (samostatná Neon branch pro testy, viz níže).

# --- Databáze (Neon, PostgreSQL) ---
# Pooled connection (aplikace za běhu)
DATABASE_URL=
# Unpooled/direct connection (Prisma migrace, viz prisma.config.ts)
DATABASE_URL_UNPOOLED=

# --- Auth.js (admin login) ---
# Vygeneruj: npx auth secret
AUTH_SECRET=

# --- QR platba (bankovní účet zobrazený v adminu u rezervace) ---
NEXT_PUBLIC_BANK_PREFIX=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_CODE=

# --- Resend (transakční e-maily) ---
RESEND_API_KEY=

# --- SMSManager.cz (připomínkové SMS klientům) ---
SMSMANAGER_API_KEY=

# --- Cron (Vercel Cron -> /api/cron/*, ověření volajícího) ---
CRON_SECRET=

# --- ICS feed (Apple Calendar subscription token) ---
ICS_FEED_TOKEN=

# --- Alerty (low SMS credit apod.) ---
ALERT_EMAIL_TO=

# --- Web Push (VAPID klíče) ---
# Vygeneruj: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:tvuj@email.cz

# --- Testy ---
# .env.test potřebuje vlastní DATABASE_URL + DATABASE_URL_UNPOOLED,
# ukazující na SAMOSTATNOU Neon branch (ne dev/prod) - `npm run pretest`
# proti ní spouští `prisma migrate deploy` před každým test runem.
